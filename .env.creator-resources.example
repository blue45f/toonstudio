# Server-only. Set these in the NestJS deployment, never as VITE_* values.
KAKAO_REST_API_KEY=
BIZINFO_API_KEY=
GOOGLE_BOOKS_API_KEY=
KMAS_PRV_KEY=

# Korean public-data integrations. 국가유산 기본 검색은 키 없이 동작합니다.
NEIS_API_KEY=
TOUR_API_SERVICE_KEY=
# Backward-compatible alias; prefer TOUR_API_SERVICE_KEY for new deployments.
TOUR_API_KEY=
KOREAN_DICTIONARY_API_KEY=

# International sources that require an application key.
SMITHSONIAN_API_KEY=
EUROPEANA_API_KEY=
GOOGLE_FONTS_API_KEY=
DPLA_API_KEY=

# Keyless providers: Met, AIC, Cleveland Museum, Poly Haven, ambientCG,
# NASA Images, V&A Collections, Rijksmuseum, Open Library, openBD,
# MusicBrainz, Wikimedia Analytics, GDELT and MET Norway.
# Do not put provider credentials, OAuth tokens or webhook URLs in browser storage.
