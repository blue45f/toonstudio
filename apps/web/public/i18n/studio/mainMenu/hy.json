  "studio.mainMenu.item.file.fallbackDescription": "Արագ բացեք Ֆայլի ընտրացանկի հրամանները՝ ձեր ակտիվներն ու նախագծերը կառավարելու համար:",
  "studio.mainMenu.item.edit.fallbackDescription": "Խմբագրման ընտրացանկը միանգամից տրամադրում է հետարկումը, սեղմատախտակը, շերտերի դասավորությունը և ընտրության կառավարումը:",
  "studio.mainMenu.item.insert.fallbackDescription": "Տեղադրել ցանկից դուք կարող եք կաղապարներ, ձևեր, պատկերներ, կերպարներ և 3D ակտիվներ տեղադրել տեսարանի մեջ:",
  "studio.mainMenu.item.view.fallbackDescription": "Անմիջապես կարգավորեք խոշորացումը, ուղղման ռեժիմը և վահանակի դասավորությունը Դիտել մենյուի միջոցով:",
  "studio.mainMenu.item.filter.fallbackDescription": "Դուք կարող եք մշակել էկրանը պղտորման, գույնի ուղղման և կորի մշակման միջոցով ֆիլտրի ընտրացանկում:",
  "studio.mainMenu.item.draw.fallbackDescription": "Արագ անցում կատարեք հիմնական գործիքների, ֆոնի և ներկապնակի ռեժիմների միջև Նկարչություն մենյուից:",
  "studio.mainMenu.item.ai.fallbackDescription": "AI մենյուից սկսեք օժանդակ գեներացիան, ֆոնդային պատկերները և ինտեգրման կարգավորումները:",
  "studio.mainMenu.hint.file.title": "Ֆայլ",
  "studio.mainMenu.hint.file.description": "Պահպանեք և ներմուծեք ձեռագրերը և արտահանեք դրանք որպես պատկերներ, PSD-ներ, նախագծերի կրկնօրինակում և հրապարակման արդյունքներ:",
  "studio.mainMenu.hint.file.tip": "Աշխատելիս օգտագործեք ժամանակավոր պահեստ և արխիվացրեք ակտիվներ պարունակող կրկնօրինակները՝ նախքան սարքերը տեղափոխելը:",
  "studio.mainMenu.hint.edit.title": "Խմբագրել",
  "studio.mainMenu.hint.edit.description": "Հետարկում, սեղմատախտակ, ընտրության կառավարում, շերտերի կարգ և կարգավորումների ընտրացանկ՝ մեկ տեղում:",
  "studio.mainMenu.hint.edit.tip": "Մենյու մտնելուց հետո կարող եք շարժվել ↑·↓ և Home·End-ով և կատարել հրամաններ Enter-ով։",
  "studio.mainMenu.hint.insert.title": "Տեղադրել",
  "studio.mainMenu.hint.insert.description": "Ավելացրեք ձևանմուշներ, խոսքի փուչիկներ, տեքստ, պատկերներ և 3D կերպարներ ու ֆոներ անմիջապես ընթացիկ տեսարանին:",
  "studio.mainMenu.hint.insert.tip": "Հաճախ օգտագործվող խոսքի փուչիկները և ակտիվները կարող են անմիջապես բացվել լայն էկրանի դյուրանցումներից:",
  "studio.mainMenu.hint.view.title": "Դիտել",
  "studio.mainMenu.hint.view.description": "Մեծացնել/փոքրացնել, հարմարեցնել էկրանին, շրջել, փոխել հեռանկարային օգնականը և վահանակի դասավորությունը:",
  "studio.mainMenu.hint.view.tip": "Եթե ​​անցնեք միայն կտավի տեսքին (`), կարող եք թաքցնել շրջակա վահանակները և կենտրոնանալ ձեր ձեռագրի վրա:",
  "studio.mainMenu.hint.filter.title": "Զտիչ",
  "studio.mainMenu.hint.filter.description": "Կիրառեք պղտորումը, երանգը, հագեցվածությունը, պայծառությունը, լուսավորությունը, հակադրությունը և գունային կորը ընտրված պատկերի կամ ներկայումս տեսանելի էջի վրա:",
  "studio.mainMenu.hint.filter.tip": "Բնօրինակը պահպանելու համար կարգավորեք էֆեկտների կարգը և ինտենսիվությունը խելացի ֆիլտրի փաթեթում:",
  "studio.mainMenu.hint.draw.title": "Նկարչություն",
  "studio.mainMenu.hint.draw.description": "Անմիջապես անցեք գրիչի, ռետինի, լրացման, խելացի ձևի, ֆոնի, տոնայնության և ներկապնակի գործողությունների:",
  "studio.mainMenu.hint.draw.tip": "Արագ փոխարկեք գրիչը, ռետինը և լցումը ձեր աշխատանքային հոսքում՝ B, E և G ստեղներով:",
  "studio.mainMenu.hint.ai.title": "AI",
  "studio.mainMenu.hint.ai.description": "Սկսեք ստեղծագործական օգնությունը AI աջակցության, ֆոնդային պատկերների և ինտեգրման կարգավորումների միջոցով:",
