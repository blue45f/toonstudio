# Required compatibility authority for routes that have not been split yet.
CLOUDFLARE_CORE_API_ORIGIN=https://core.example.test

# NEIS_API_KEY is intentionally absent: register it only with
# `wrangler secret put NEIS_API_KEY --config deploy/cloudflare-static/wrangler.jsonc`.

# Optional comma-separated pool (maximum 8) for stateless GET/HEAD/OPTIONS
# catalog reads: /api/random, /api/home, /api/calendar, /api/insights,
# /api/ranking, /api/explore, /api/tags, /api/search, /api/titles/*,
# /api/authors/*, /api/kmas/book-webtoons, /api/cover, and /api/public/*.
# Operational /api/catalog/*, /api/health/*, and /api/config stay on core.
CLOUDFLARE_PUBLIC_READ_API_ORIGINS=https://catalog-a.example.test,https://catalog-b.example.test

# Optional isolated authorities. When omitted, that workload remains on core.
CLOUDFLARE_SOCIAL_API_ORIGIN=https://social.example.test
CLOUDFLARE_PLAYGROUND_API_ORIGIN=https://playground.example.test
CLOUDFLARE_ADMIN_API_ORIGIN=https://admin.example.test
CLOUDFLARE_REALTIME_API_ORIGIN=https://realtime.example.test

# Final fallback only. Compressed Static Assets handles ordinary reads and
# R2 LARGE_ASSETS handles Range or uncompressed reads above the 25 MiB limit.
CLOUDFLARE_LARGE_ASSET_ORIGIN=https://origin.example.test

# Cloudflare builds use the generated static catalog by default so catalog reads
# stay on Static Assets. Set api only for a reviewed compatibility rollback.
VITE_CATALOG_SOURCE=static

# 현행 운영 진입점: 저장소 루트에서 pnpm run deploy:web (onpod-current 프로필).
# 유효한 deploy/cloudflare-static/STANDING_APPROVAL.json이 있으면 매 릴리스 승인 변수는 생략한다.
# 상시 승인 파일이 없을 때만 사용자 명시 승인 후 아래 두 변수를 함께 설정한다:
# TOONSPECTRUM_MANUAL_DEPLOY_APPROVAL=cloudflare-static-production
# TOONSPECTRUM_APPROVED_MAIN_SHA=<승인된 main의 소문자 40자리 SHA>
# 두 방식 모두 clean main == origin/main 끝 SHA, 해당 SHA core/verify 성공, 롤백 대상과 중복 원장 확인이 필요하다.
# 전체 배포의 R2 동기화는 승인된 세션의 CLOUDFLARE_API_TOKEN을 요구한다. OAuth 로그인만으로 대체하지 않는다.
# 값은 이 예제에 저장하지 않는다. 세부 검증·빌드·사후 확인: docs/operations/ai-deployment-quickstart.md.
