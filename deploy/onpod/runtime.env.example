# 상태: current — 2026-10-29 인프라 지도 기록. 원격 조회·주입·배포가 아니다.
# 독립 cloud shell은 로컬 .env.infrastructure.local / Wrangler Keychain을 읽을 수 없다.
# 아래 설정은 비밀 없는 참조이며 토큰과 DSN은 승인한 환경에 별도로 주입해야 한다.
# contract: config/deployment/environment-contract.json / profile: onpod-current
NODE_ENV=production
CORE_API_ORIGIN=https://toonstudio-api.onpod.ai
DATABASE_RUNTIME_ROLE_MODE=single-owner
AUTH_RATE_LIMIT_MODE=single-instance-local
AUTH_EDGE_CLIENT_IP_ENABLED=true
STUDIO_LIVE_CLUSTER_ADAPTER=memory
TRAFFIC_ANALYTICS_STORE=d1
# DATABASE_URL=                         # API secret store, 내부 DB DSN
# AUTH_SESSION_SECRET=                  # API secret store
# AUTH_STATE_SECRET=                    # API secret store
# CLOUDFLARE_EDGE_ORIGIN_SECRET=         # API secret store; Worker CORE_ORIGIN_SECRET과 동일
# TRAFFIC_ANALYTICS_D1_RPC_URL=           # API 설정; 정확한 /query URL 별도 확인
# TRAFFIC_ANALYTICS_D1_RPC_TOKEN=         # API secret store; Worker ANALYTICS_RPC_TOKEN과 동일
# STUDIO_REALTIME_CLOUDFLARE_TICKET_SECRET= # API secret store; Worker REALTIME_TICKET_SECRET과 동일
# STUDIO_REALTIME_CLOUDFLARE_CONTROL_SECRET= # API secret store; Worker REALTIME_CONTROL_SECRET과 동일
# Worker의 secret은 각 Worker secret store에서 관리한다. 이 예제를 통째로 API에 주입하지 않는다.
