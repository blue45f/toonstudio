# ToonStudio external integration runtime connectors.
# Keep every value in the deployment secret store. Never expose these as VITE_* variables.
# Unconfigured connectors remain visible for dry-run planning but live execution fails closed.

# Work management
NOTION_API_TOKEN=
# Override only after reviewing the Notion API upgrade guide.
NOTION_API_VERSION=2026-03-11
LINEAR_API_TOKEN=
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Prefer a scoped access token. The legacy key/token pair remains supported when required.
TRELLO_ACCESS_TOKEN=
TRELLO_API_KEY=
TRELLO_TOKEN=

# Team notifications
SLACK_WEBHOOK_URL=
MICROSOFT_TEAMS_WEBHOOK_URL=

# Design handoff and review meetings
FIGMA_ACCESS_TOKEN=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# External insight sources
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Google Books search works without a key at low volume; a key can be supplied for operator quota management.
GOOGLE_BOOKS_API_KEY=

# Durable per-actor live-execution ceiling, reset at 00:00 UTC. Valid range: 1..1000.
INTEGRATION_RUNTIME_DAILY_EXECUTIONS_PER_ACTOR=100

# 운영자 인증 정보 커넥터 허용 목록(JSON 배열). 비워 두면 관리자만 위의 운영자 토큰·웹훅 커넥터를 실행합니다.
# 항목: projectId, providerId, targets(허용할 Notion 데이터 소스·Linear 팀·Jira 프로젝트 키·Trello 리스트·Figma 파일·Zoom 사용자 ID).
# Slack·Teams·Naver DataLab 은 targets 를 생략합니다. 와일드카드는 지원하지 않으며 형식이 틀리면 전부 무시(관리자 전용)합니다.
# 예) [{"projectId":"replace-with-project-id","providerId":"notion","targets":["replace-with-data-source-id"]}]
INTEGRATION_RUNTIME_OPERATOR_GRANTS=
