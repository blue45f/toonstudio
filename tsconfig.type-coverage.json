{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "artifacts/**",
    "apps/api/**",
    "dist/**",
    "**/__diag*",
    "worktrees/**",
    ".worktrees/**",
    ".claude/worktrees/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mts",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.spec.mts",
    "**/__tests__/**",
    "apps/web/tests/**"
  ]
}
