{
  "name": "@toonstudio/studio-engine-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Engine capability registry, provider descriptors, hybrid execution planner and the renderer-candidate manifest that decide which engine runs each workload.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./renderer-roles": {
      "types": "./src/renderer-roles.ts",
      "import": "./src/renderer-roles.ts",
      "default": "./src/renderer-roles.ts"
    },
    "./wgsl-variants": {
      "types": "./src/wgsl-variants.ts",
      "import": "./src/wgsl-variants.ts",
      "default": "./src/wgsl-variants.ts"
    },
    "./wesl-compile": {
      "types": "./src/wesl-compile.ts",
      "import": "./src/wesl-compile.ts",
      "default": "./src/wesl-compile.ts"
    },
    "./descriptor": {
      "types": "./src/descriptor.ts",
      "import": "./src/descriptor.ts",
      "default": "./src/descriptor.ts"
    },
    "./registry": {
      "types": "./src/registry.ts",
      "import": "./src/registry.ts",
      "default": "./src/registry.ts"
    },
    "./planner": {
      "types": "./src/planner.ts",
      "import": "./src/planner.ts",
      "default": "./src/planner.ts"
    },
    "./planner-cost-shadow": {
      "types": "./src/planner-cost-shadow.ts",
      "import": "./src/planner-cost-shadow.ts",
      "default": "./src/planner-cost-shadow.ts"
    },
    "./tournament": {
      "types": "./src/tournament.ts",
      "import": "./src/tournament.ts",
      "default": "./src/tournament.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7",
    "@toonstudio/studio-project-model": "workspace:*"
  }
}
