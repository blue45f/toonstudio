{
  "name": "@toonstudio/studio-brush-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Engine-neutral pointer input, stabilizer and stroke-geometry brush platform: raw pointer samples through to compiled vector and raster stroke geometry.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./libmypaint": {
      "types": "./src/libmypaint.ts",
      "import": "./src/libmypaint.ts",
      "default": "./src/libmypaint.ts"
    },
    "./natural-media": {
      "types": "./src/natural-media/dip-pen-railroading-and-impasto.ts",
      "import": "./src/natural-media/dip-pen-railroading-and-impasto.ts",
      "default": "./src/natural-media/dip-pen-railroading-and-impasto.ts"
    },
    "./spectral-km": {
      "types": "./src/pigment/spectral-38band-km.ts",
      "import": "./src/pigment/spectral-38band-km.ts",
      "default": "./src/pigment/spectral-38band-km.ts"
    },
    "./spectral-km-wgsl": {
      "types": "./src/pigment/spectral-38band-km-wgsl.ts",
      "import": "./src/pigment/spectral-38band-km-wgsl.ts",
      "default": "./src/pigment/spectral-38band-km-wgsl.ts"
    },
    "./linked-ink": {
      "types": "./src/linked-ink/linked-ink-barycentric-evaluator.ts",
      "import": "./src/linked-ink/linked-ink-barycentric-evaluator.ts",
      "default": "./src/linked-ink/linked-ink-barycentric-evaluator.ts"
    },
    "./stroke-budget": {
      "types": "./src/stroke-budget.ts",
      "import": "./src/stroke-budget.ts",
      "default": "./src/stroke-budget.ts"
    },
    "./compile": {
      "types": "./src/compile.ts",
      "import": "./src/compile.ts",
      "default": "./src/compile.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run src"
  },
  "dependencies": {
    "@toonstudio/studio-project-model": "workspace:*",
    "@toonstudio/studio-engine-registry": "workspace:*",
    "perfect-freehand": "1.2.3"
  }
}
