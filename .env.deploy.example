# ToonStudio — 로컬 ↔ GitHub Actions 클라우드 배포 설정 참조 템플릿 (.env.deploy.example)
#
# 정본 로컬 비밀 저장소는 `.env.infrastructure.local` (권한 0600, Git 추적 제외)입니다.
# 로컬 PC에서 1회 `pnpm run deploy:auth:sync`를 실행하면 아래 배포 필수 설정이
# GitHub Actions의 `production-deploy` Environment(main 브랜치 전용)에 안전하게 주입되어,
# 로컬 `.env`가 전혀 없는 클라우드 환경(Codex Cloud, Codespaces, GitHub 웹 UI 등)에서도
# `pnpm run deploy:cloud` 또는 수동 `workflow_dispatch`만으로 배포할 수 있습니다.
#
# 주의:
# - 실제 비밀값은 절대 커밋·출력·source/eval 하지 않습니다(AGENTS.md 9절).
# - 전권 `ONPOD_TOKEN` 및 `ONPOD_DATABASE_URL*`은 GitHub에 업로드하지 않으며,
#   `pnpm run deploy:auth -- --provision-onpod-key`로 발급한 앱 전용 `ONPOD_DEPLOY_TOKEN`만 주입합니다.

# [1] Cloudflare 정적 웹 + R2 + Worker 배포 설정
# Variables (`production-deploy` Environment)
CLOUDFLARE_ACCOUNT_ID=
CORE_API_ORIGIN=https://toonstudio-api.onpod.ai

# Secrets (`production-deploy` Environment — Workers Scripts:Edit + Workers R2 Storage:Edit 최소권한)
CLOUDFLARE_API_TOKEN=
CORE_ORIGIN_SECRET=
NEIS_API_KEY=

# [2] 공개 웹 빌드 변수 (`apps/web` Vite 프로덕션 빌드)
VITE_CATALOG_SOURCE=static
VITE_STUDIO_LIVE_ORIGIN=https://www.toonstudio.cloud
VITE_STUDIO_REALTIME_ORIGIN=https://realtime.toonstudio.cloud
VITE_STUDIO_REALTIME_PROVIDER_ID=cloudflare-realtime-v1
VITE_STUDIO_AUTOMERGE_OFFLINE_BRANCH=true
VITE_KAKAO_JAVASCRIPT_KEY=

# [3] 서울 onpod Core API (`toonstudio-api`) 클라우드 배포 설정
ONPOD_APP_NAME=toonstudio-api
# `onpod key add --app toonstudio-api --expires-days 90`으로 발급한 앱 전용 토큰만 사용
ONPOD_DEPLOY_TOKEN=
# `.env.infrastructure.local`의 `ONPOD_API_ENV_*` 항목들이 자동 검증 후 `ONPOD_API_ENV_JSON` 시크릿으로 동기화됨 (`DATABASE_URL` 제외)
