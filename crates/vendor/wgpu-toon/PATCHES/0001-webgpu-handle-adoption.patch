+// TOON-PATCH 0001 hunk 3/3 — adopt an externally created `GPUDevice`.
+//
+// WHY: `WebDevice`/`WebQueue` are only ever built inside
+// `future_request_device`, i.e. exclusively from a device wgpu itself
+// requested. Nothing here needs to change for adoption to be sound — every
+// `Drop` impl in this backend is already a no-op, so wgpu never destroys the
+// handle it wraps, and `Identifier::create()` keeps the usual per-object
+// identity contract. (Texture adoption needs no hunk: wgpu 30 already ships
+// `WebDevice::wrap_external_texture` upstream.)
+// UPSTREAM: absent from wgpu 30.0.1 as well (30 ships only the *export*
+// direction). This is the ToonStudio upstream PR candidate (V12 §5.4).
+// REMOVE WHEN: upstream accepts external-handle device adoption.
+#[cfg(feature = "toon-fabric")]
+impl WebDevice {
+    /// Wraps a `GPUDevice` this crate did not create.
+    ///
+    /// The caller keeps ownership of the JS object: wgpu never calls
+    /// `destroy()` on it and never drops it (`Drop for WebDevice` is a no-op).
+    pub(crate) fn from_external_handle(device: webgpu_sys::GpuDevice) -> Self {
+        Self {
+            inner: device,
+            ident: crate::cmp::Identifier::create(),
+            error_scope_count: Rc::new(Cell::new(0)),
+        }
+    }
+}
+
+#[cfg(feature = "toon-fabric")]
+impl WebQueue {
+    /// Wraps a `GPUQueue` this crate did not create — pair with
+    /// [`WebDevice::from_external_handle`] using `device.queue()` so the queue
+    /// and device belong to the same JS object.
+    pub(crate) fn from_external_handle(queue: webgpu_sys::GpuQueue) -> Self {
+        Self {
+            inner: queue,
+            ident: crate::cmp::Identifier::create(),
+        }
+    }
+}
