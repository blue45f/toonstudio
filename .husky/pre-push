#!/usr/bin/env sh
# core.hooksPath 는 husky 가 생성하는 .husky/_ 가 아니라 이 디렉터리(.husky)를 가리킨다.
# Tier 2 (Changed-Scope Push Gate): 아키텍처·UI/UX v2.2 계약, 타입체크, 변경 파일 린트·시크릿을
# 병렬 실행하고 변경 단위 테스트를 이어 실행한다.
# 전체 Web/API 타입 검사가 포함되므로 실행 시간은 코드 규모와 환경에 따라 달라진다.
set -e

if ! command -v pnpm >/dev/null 2>&1; then
  REAL_HOME="$HOME"
  case "$REAL_HOME" in
    *"/.gemini/"*)
      REAL_HOME="$(dscl . -read /Users/"$(id -un)" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
      [ -z "$REAL_HOME" ] && REAL_HOME="/Users/$(id -un)"
      ;;
  esac
  if [ -d "$REAL_HOME/.nvm/versions/node" ]; then
    for _d in $(ls -d "$REAL_HOME/.nvm/versions/node"/*/bin 2>/dev/null | sort -V); do
      PATH="$_d:$PATH"
    done
  fi
  PATH="$REAL_HOME/Library/pnpm:$REAL_HOME/.local/share/pnpm:/opt/homebrew/bin:/usr/local/bin:$PATH"
  export PATH
  if ! command -v pnpm >/dev/null 2>&1 && command -v corepack >/dev/null 2>&1; then
    corepack enable pnpm >/dev/null 2>&1 || true
  fi
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: pnpm 을 찾지 못했습니다. corepack(또는 nvm)으로 pnpm 을 설치하거나," >&2
  echo "          GUI 클라이언트라면 ~/.config/husky/init.sh 에 PATH 를 설정하세요." >&2
  exit 127
fi

node --test scripts/agent-harness.test.mjs scripts/verify-ui-ux-v2-contracts.test.mjs scripts/run-changed-unit-tests.test.mjs
node scripts/verify-pnpm-lockfile.mjs

BASE="${PRE_PUSH_BASE:-origin/main}"
git rev-parse --verify --quiet "$BASE" >/dev/null || BASE=""

# 읽기 전용 정적 검증(아키텍처·타입체크·변경 린트·시크릿)을 병렬 실행해 푸시 지연을 줄인다.
pnpm run validate:architecture &
PID_ARCH=$!

NODE_OPTIONS='--max-old-space-size=16384' pnpm run typecheck &
PID_TSC=$!

if [ -n "$BASE" ]; then
  node scripts/lint-changed.mjs "--base=$BASE" &
  PID_LINT=$!
  node scripts/secretlint-files.mjs "--base=$BASE" &
  PID_SECRET=$!
else
  node scripts/lint-changed.mjs &
  PID_LINT=$!
  pnpm run quality:secrets &
  PID_SECRET=$!
fi

wait "$PID_ARCH"
wait "$PID_TSC"
wait "$PID_LINT"
wait "$PID_SECRET"

if [ -n "$BASE" ]; then
  node scripts/run-changed-unit-tests.mjs "--base=$BASE"
  if git diff --name-only "$BASE...HEAD" -- package.json pnpm-lock.yaml packages/studio-hokusai-wasm \
    | grep -q .; then
    pnpm run audit:security
    pnpm run audit:licenses
  fi
else
  node scripts/run-changed-unit-tests.mjs
fi
