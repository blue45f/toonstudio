{
  "$schema": "https://toonstudio.kr/schemas/plugin-manifest-v2.json",
  "id": "toonstudio.official-mcp-pack",
  "name": "ToonStudio Official MCP, CLI & Skill Pack",
  "displayNameKo": "ToonStudio 공식 MCP·CLI·에이전트 스킬 패키지",
  "version": "2.4.0",
  "sdkApiVersion": "^2.4.0",
  "authorId": "toonstudio-core",
  "authorName": "ToonStudio",
  "category": "workflow-tool",
  "description": "외부 AI 에이전트(Claude Code, Cursor, Gemini CLI, Codex, Antigravity)가 ToonStudio 44종 웹툰 창작·분업·출고·OSMU·보안 툴을 ₩0 Fail-Closed 가드레일 안에서 표준 MCP/CLI로 실행하는 공식 패키지입니다.",
  "entryModule": "./server.mjs",
  "cliEntry": "./cli.mjs",
  "requestedScopes": [
    "canvas.read",
    "asset.insert",
    "export.hook",
    "material.publish"
  ],
  "permissions": {
    "scopes": [
      "canvas.read",
      "asset.insert",
      "export.hook",
      "material.publish"
    ],
    "deniedScopes": [
      "auth.session",
      "filesystem.host",
      "network.external",
      "shell.unrestricted",
      "secrets.read"
    ],
    "isolationMode": "sandboxed-worker-no-network"
  },
  "zeroCostGuard": {
    "guaranteedCostUsd": 0,
    "guaranteedCostKrwLabel": "₩0",
    "paidBillingBlocked": true,
    "secretsRedacted": true
  },
  "mcpServers": {
    "toonstudio": {
      "transport": "stdio",
      "protocolVersion": "2024-11-05",
      "command": "node",
      "args": [
        "tools/toonstudio-mcp/server.mjs",
        "--state-file",
        ".cache/toonstudio-mcp-state.json"
      ],
      "capabilities": [
        "tools",
        "resources",
        "prompts"
      ],
      "toolCount": 44
    }
  },
  "skills": [
    {
      "id": "toonstudio-creator",
      "name": "ToonStudio Creator Workflow",
      "path": "./skills/toonstudio-creator/SKILL.md",
      "locale": "ko",
      "clients": [
        "claude",
        "cursor",
        "gemini",
        "codex",
        "antigravity"
      ]
    }
  ],
  "commands": [
    {
      "name": "doctor",
      "summary": "Node·빌드 산출물·MCP 44툴·플러그인·무과금 가드레일 종합 진단"
    },
    {
      "name": "mcp-config",
      "summary": "claude|cursor|gemini|codex|antigravity 클라이언트용 즉시 연동 JSON 생성"
    },
    {
      "name": "init-skill",
      "summary": "지정 디렉터리에 공식 toonstudio-creator 스킬 스캐폴딩 설치"
    },
    {
      "name": "completion",
      "summary": "zsh 또는 bash 쉘 자동완성 스크립트 출력"
    },
    {
      "name": "verify-plugin",
      "summary": "서드파티 플러그인 또는 공식 스킬 매니페스트 샌드박스 보안 검증"
    },
    {
      "name": "list",
      "summary": "등록된 44종 표준 MCP 툴 목록 조회"
    },
    {
      "name": "quota",
      "summary": "무료 AI 공급자 안전 할당량(₩0 · 키 미노출) 조회"
    },
    {
      "name": "ai-modes",
      "summary": "14종 무과금 웹툰 AI 창작 보조 모드 목록 조회"
    },
    {
      "name": "batch",
      "summary": "여러 MCP 툴 체인 일괄 실행"
    },
    {
      "name": "call",
      "summary": "단일 MCP 툴 직접 호출"
    },
    {
      "name": "draw-demo",
      "summary": "캔버스 스트로크·말풍선·VFX SVG 생성 데모"
    },
    {
      "name": "mcp",
      "summary": "JSON-RPC 2.0 STDIO MCP 서버 실행"
    }
  ]
}
